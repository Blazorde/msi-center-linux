#!/usr/bin/env bash
# Enforces Conventional Commits on the first line (see docs/development/git-workflow.md).
set -euo pipefail

subject=$(head -n1 "$1")

# Messages generated by git itself.
if [[ $subject =~ ^(Merge|Revert|fixup!|squash!) ]]; then
    exit 0
fi

pattern='^(feat|fix|docs|refactor|test|perf|chore|ci|build)(\((core|daemon|clip|clipd|app|ext|kernel|pkg|ci|docs|release|deps)\))?!?: .+$'

if [[ ! $subject =~ $pattern ]]; then
    echo "✗ Message non conforme aux Conventional Commits : \"$subject\"" >&2
    echo "  Attendu : <type>(<scope>): <résumé>   ex. feat(daemon): add fan curve sampling" >&2
    exit 1
fi

if (( ${#subject} > 72 )); then
    echo "✗ Première ligne trop longue (${#subject} > 72)." >&2
    exit 1
fi
